+// Keep uploads serialized, but issue several copies on one worker-owned backend
+// stream before synchronizing. Every RAM lease and LOADING slot survives until
+// that synchronization; no other worker can recycle bytes in flight. Arithmetic,
+// routing, graph shapes and slot selection are untouched.
+void llama_moe_stream::worker_loop_batched(int worker_id) {
+    struct pending {
+        llama_moe_stream_work work;
+        const uint8_t * data = nullptr;
+        size_t pinned = SIZE_MAX;
+        size_t filled = SIZE_MAX;
+        size_t head = 0;
+    };
+    std::vector<uint8_t *> staging(upload_batch);
+    for (auto & ptr : staging) {
+        ptr = (uint8_t *) moe_aligned_alloc(max_nb_expert + 2*MOE_STREAM_DIRECT_ALIGN);
+        GGML_ASSERT(ptr != nullptr);
+    }
+    std::vector<pending> batch;
+    batch.reserve(upload_batch);
+    ggml_backend_ptr uploader;
+    ggml_backend_dev_t device = nullptr;
+    std::unique_lock<std::mutex> lk(mtx);
+    while (true) {
+        cv_work.wait(lk, [&]{ return shutting_down || !q_demand.empty(); });
+        if (shutting_down) {
+            break;
+        }
+        batch.clear();
+        while (!q_demand.empty() && batch.size() < (size_t) upload_batch) {
+            const auto w = q_demand.front();
+            q_demand.pop_front();
+            auto & sl = *w.sl;
+            const uint8_t bit = (uint8_t) (1u << w.weight);
+            if (w.gen != sl.slot_gen[w.slot] ||
+                sl.slot_state[w.slot] != LLAMA_MOE_STREAM_SLOT_LOADING ||
+                sl.slot_expert[w.slot] != w.expert || (sl.slot_claimed[w.slot] & bit)) {
+                continue;
+            }
+            sl.slot_claimed[w.slot] |= bit;
+            batch.push_back({ w });
+        }
+        lk.unlock();
+        for (size_t i = 0; i < batch.size(); ++i) {
+            auto & p = batch[i];
+            const auto & wt = p.work.sl->weights[p.work.weight];
+            const size_t offs = wt.offs + (size_t) p.work.expert * wt.nb_expert;
+            p.data = l2 ? l2->find(wt.file_idx, offs, wt.nb_expert, &p.pinned) : nullptr;
+            if (p.data == nullptr) {
+                size_t slot = SIZE_MAX;
+                uint8_t * dst = l2 ? l2->reserve(wt.file_idx, offs, wt.nb_expert, &slot) : nullptr;
+                p.data = llama_moe_stream_pread(*files[wt.file_idx], dst ? dst : staging[i],
+                                               wt.nb_expert, offs, use_direct_io, worker_id);
+                if (dst) {
+                    if (p.data) {
+                        p.filled = slot;
+                        p.head = (size_t) (p.data - dst);
+                    } else {
+                        l2->abandon(slot);
+                    }
+                }
+            }
+        }
+        {
+            std::lock_guard<std::mutex> up(upload_mtx);
+            for (const auto & p : batch) {
+                if (!p.data) {
+                    continue;
+                }
+                const auto & wt = p.work.sl->weights[p.work.weight];
+                auto dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(wt.cache->buffer));
+                if (!uploader) {
+                    // This experimental path has only been validated on CUDA.
+                    GGML_ASSERT(dev && std::strncmp(ggml_backend_dev_name(dev), "CUDA", 4) == 0);
+                    device = dev;
+                    uploader.reset(ggml_backend_dev_init(dev, nullptr));
+                    GGML_ASSERT(uploader);
+                }
+                GGML_ASSERT(dev == device);
+                ggml_backend_tensor_set_async(uploader.get(), wt.cache, p.data,
+                                             (size_t) p.work.slot * wt.nb_expert, wt.nb_expert);
+            }
+            if (uploader) {
+                ggml_backend_synchronize(uploader.get());
+            }
+        }
+        for (const auto & p : batch) {
+            if (p.filled != SIZE_MAX) {
+                l2->commit(p.filled, p.head);
+            }
+            if (p.pinned != SIZE_MAX) {
+                l2->release(p.pinned);
+            }
+        }
+        lk.lock();
+        for (const auto & p : batch) {
+            const auto & w = p.work;
+            auto & sl = *w.sl;
+            if (w.gen != sl.slot_gen[w.slot]) {
+                continue;
+            }
+            sl.slot_claimed[w.slot] &= (uint8_t) ~(1u << w.weight);
+            if (!p.data) {
+                load_failed = true;
+            } else if (sl.slot_parts_left[w.slot] > 0 && --sl.slot_parts_left[w.slot] == 0) {
+                sl.slot_state[w.slot] = LLAMA_MOE_STREAM_SLOT_RESIDENT;
+            }
+        }
+        cv_done.notify_all();
+    }
+    lk.unlock();
+    for (auto ptr : staging) {
+        moe_aligned_free(ptr);
+    }
+}
